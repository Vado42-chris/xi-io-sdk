  "hard": [
    "CLI_COMMAND != AUTHORITY",
    "COMMAND_ALIAS != COMMAND_SEMANTIC_OWNER",
    "ACK_PACKET != DELIVERY",
    "DISTRIBUTED_ACK != PROVIDER_ASSIGNMENT",
    "ACK != ATTEMPT",
    "RESULT != RETURN != APPLY_RETURN",
    "BASELINE_ACCOUNTING != CLOSURE_100",
    "BURNMAP != WORK_AUTHORITY",
    "EXTERNAL_AI_PROVIDER != CANONICAL_STATE_OWNER",
