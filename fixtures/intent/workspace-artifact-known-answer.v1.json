      "id": "explicit-relative-zip",
      "input": "inspect consoles/console.zip",
      "expect": {"state":"RESOLVED","resolved_path":"consoles/console.zip","artifact_class":"ARCHIVE","requested_operation":"INSPECT_ARCHIVE","owner_reprompt_needed":false}
    },
    {
      "id": "text-in-folder",
      "input": "read \"README.md\" in the \"docs\" folder",
