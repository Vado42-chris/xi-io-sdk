  "openapi": "3.1.0",
  "info": {
    "title": "XI-IO PNEUMA candidate local control plane",
    "version": "0.1.0-candidate",
    "description": "Candidate contract only. Endpoint availability and authority must be independently discovered; no route is claimed live."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8794",
      "description": "Candidate local CRM, runtime unverified"
    }
  ],
  "components": {
    "schemas": {
      "Receipt": {
        "type": "object",
        "required": [
          "state",
          "effect_performed",
          "source_generation"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "WAIT",
              "REJECTED",
              "QUALIFIED",
              "COMMITTED",
              "READBACK_VERIFIED"
            ]
          },
          "effect_performed": {
            "type": "boolean"
          },
          "source_generation": {
            "type": "string"
          },
          "receipt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "pre_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "post_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "next": {
            "type": "string"
          },
          "owner_action_required": {
            "type": "boolean"
          }
        }
      },
      "Mutation": {
        "type": "object",
        "required": [
          "surface",
          "mutations",
          "expected_sha256",
          "actor_id",
          "work_uuid"
        ],
        "properties": {
          "surface": {
            "type": "string"
          },
          "mutations": {
            "type": "object"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "actor_id": {
            "type": "string"
          },
          "work_uuid": {
            "type": "string"
          }
        }
      }
    }
  },
