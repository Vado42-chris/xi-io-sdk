  "permission_policy": {
    "zed_setting": "agent.tool_permissions.default",
    "recommended_default": "confirm",
    "tool_name_example": "mcp:xiio:work_submit",
    "read_only": "allow when independently bounded",
    "source_mutation": "Ward gate regardless of Zed approval",
    "effects": "require authoritative admission and independently verified readback",
    "note": "Zed permission rules are a host prompt/ACL, not Ward authorization."
  },
  "five_point_five": {
    "observers": "distinct agent/work identities, not UI tabs",
    "base": "immutable fixture/source generation",
    "return": "Result -> APPLY_RETURN -> REAP -> Studio readback",
    "independent_effect_proof_required": true
