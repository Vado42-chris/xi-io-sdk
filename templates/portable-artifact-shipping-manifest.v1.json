{
  "schema": "xiio.sdk.portable-artifact-shipping-manifest-template/v1",
  "template_only": true,
  "executable": false,
  "hard": [
    "TEMPLATE != ARTIFACT",
    "PLACEHOLDER != BINDING",
    "COPY_TEMPLATE_THEN_BIND_EXACT_REFS",
    "NO_OWNER_RELAY_FOR_MACHINE_RESOLVABLE_FIELDS"
  ],
  "cube_id": "REQUIRED",
  "file": {
    "file_id": "REQUIRED",
    "artifact_role": "REQUIRED",
    "semantic_generation": "REQUIRED",
    "profile_id": "RESOLVE_WITH_xi-io_file_profile",
    "payload": {},
    "source_bindings": [
      {
        "ref": "REQUIRED",
        "generation": "REQUIRED",
        "role": "primary"
      }
    ],
    "dependency_bindings": [],
    "projection_refs": [],
    "provider_projections": []
  },
  "dependency_policy": "EXPLICIT_OR_NONE_REQUIRED",
