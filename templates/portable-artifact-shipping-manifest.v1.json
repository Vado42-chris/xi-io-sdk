    "profile_id": "REQUIRED_REGISTERED_PROFILE"
  },
  "consumer_profile": {
    "profile_id": "REQUIRED_REGISTERED_PROFILE"
  },
  "hex_floor_ref": "~/.local/state/xi-io/hex/floor.current.json",
